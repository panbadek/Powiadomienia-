<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nagłówek -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Ikona Dzielnika"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dzielnik"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tnie tekst na części i wysyła je jako powiadomienia" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1. Tekst -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Wklej tekst" />

            <EditText
                android:id="@+id/text"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="top|start"
                android:hint="Tutaj wklej tekst do wysłania"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="10"
                android:minLines="6"
                android:scrollbars="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_paste"
                    style="@style/TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wklej ze schowka" />

                <Button
                    android:id="@+id/btn_clear"
                    style="@style/TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wyczyść" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Ustawienia -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Ustaw części" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Długość części (znaki)" />

                    <EditText
                        android:id="@+id/limit"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Przerwa (sekundy)" />

                    <EditText
                        android:id="@+id/delay"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="4" />
                </LinearLayout>
            </LinearLayout>

            <Switch
                android:id="@+id/sw_reverse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:text="Wysyłaj od ostatniej części do pierwszej"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Najnowsze powiadomienie jest w panelu na samej górze. Przy tej opcji część 1 przyjdzie ostatnia, więc będzie pierwsza od góry." />

            <TextView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Wyślij -->
        <Button
            android:id="@+id/btn_send"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Podziel i wyślij" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            style="@style/Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="14sp" />

        <!-- Gemini -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gemini w powiadomieniach" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gdy wpiszesz klucz, powiadomienia dostają przycisk „Odpowiedz”. Twoja odpowiedź razem z treścią powiadomienia idzie do Gemini, a jego odpowiedź wraca jako kolejne powiadomienia, dzielone tak samo jak tekst." />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Klucz API Gemini" />

            <EditText
                android:id="@+id/gem_key"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Wklej klucz z Google AI Studio"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Klucz zapisuje się tylko w tym telefonie i jest wysyłany wyłącznie do Google." />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Model" />

            <EditText
                android:id="@+id/gem_model"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="gemini-3.5-flash-lite"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Wersja Lite ma największy darmowy limit dzienny. Mocniejszy model, np. gemini-3.8-flash, odpowiada lepiej, ale darmowych pytań jest wtedy mało." />

            <Switch
                android:id="@+id/sw_reply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Przycisk „Odpowiedz” w powiadomieniach"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Zapytaj Gemini bez powiadomienia" />

            <EditText
                android:id="@+id/gem_question"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="top|start"
                android:hint="Wpisz pytanie"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minLines="2"
                android:scrollbars="vertical" />

            <Button
                android:id="@+id/btn_ask"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Zapytaj Gemini" />

            <Button
                android:id="@+id/btn_ask_notif"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wstaw do powiadomień pole pytania" />

            <TextView
                android:id="@+id/gem_status"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_new_chat"
                style="@style/TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Zacznij nową rozmowę" />
        </LinearLayout>

        <!-- Telegram: odpowiadanie z zegarka -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odpowiadanie z zegarka (Telegram)" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Zegarek Huawei pozwala odpowiadać na powiadomienia tylko z wybranych komunikatorów, m.in. z Telegrama, więc powiadomienia Dzielnika nie dostaną na nim przycisku odpowiedzi. Dzielnik może za to pisać do Ciebie przez własnego bota w Telegramie. Odpowiadasz na zegarku, odpowiedź idzie do Gemini i wraca jako kolejna wiadomość." />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1. W Telegramie otwórz @BotFather, wyślij /newbot i skopiuj token.\n2. Wklej go poniżej, otwórz swojego bota, napisz /start i naciśnij „Połącz”.\n3. Włącz nasłuch i wybierz, gdzie wysyłać części.\n4. W aplikacji Huawei Zdrowie włącz dla zegarka powiadomienia z Telegrama." />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Token bota" />

            <EditText
                android:id="@+id/tg_token"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Token od @BotFather"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Token zapisuje się tylko w tym telefonie. Wiadomości przechodzą przez serwery Telegrama, więc nie wysyłaj tak niczego poufnego." />

            <Button
                android:id="@+id/btn_tg_connect"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Połącz z botem" />

            <TextView
                android:id="@+id/tg_status"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/sw_tg_listen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Nasłuchuj pytań z Telegrama"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nasłuch działa w tle z ikoną w pasku powiadomień. Po ponownym uruchomieniu telefonu otwórz Dzielnika, a włączy się sam. Żeby odpowiedź z zegarka dochodziła też przy wygaszonym ekranie, pozwól Dzielnikowi pracować bez ograniczeń baterii." />

            <Button
                android:id="@+id/btn_battery"
                style="@style/TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bateria: pozwól na pracę w tle" />

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gdzie wysyłać części tekstu i odpowiedzi Gemini" />

            <RadioGroup
                android:id="@+id/rg_dest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_dest_notif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Powiadomienia Dzielnika"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_dest_tg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Telegram"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_dest_both"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="Oba"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odpowiedź na pytanie zadane z Telegrama wraca do Telegrama. Wybór „Oba” dodaje do tego powiadomienia Dzielnika. Bez połączonego bota wszystko idzie jak dotąd, w powiadomieniach." />

            <Button
                android:id="@+id/btn_tg_test"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wyślij wiadomość testową do Telegrama" />
        </LinearLayout>

        <!-- Pomiar -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/measure_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Zmierz limit powiadomienia" />

                <TextView
                    android:id="@+id/measure_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pokaż"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/measure_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Telefon lub zegarek pokazuje tylko początek długiego powiadomienia. Sprawdź, ile znaków się mieści:\n1. Naciśnij „Wyślij test”.\n2. Rozwiń powiadomienie i przepisz jego końcówkę razem ze średnikiem przed ostatnią liczbą, np. ;120;45\n3. Naciśnij „Oblicz długość”." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/test_len"
                        style="@style/Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="Długość testu"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4" />

                    <Button
                        android:id="@+id/btn_test"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wyślij test" />
                </LinearLayout>

                <EditText
                    android:id="@+id/seen"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Końcówka, którą widzisz, np. ;120;45"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions|textVisiblePassword" />

                <Button
                    android:id="@+id/btn_decode"
                    style="@style/SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Oblicz długość" />

                <TextView
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_use"
                    style="@style/SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="Ustaw jako długość części" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />
    </LinearLayout>
</ScrollView>
